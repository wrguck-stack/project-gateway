APP_MODE=demo
# Optional path for the single-process, persistent demo repository.
# GATEWAY_DATA_DIR=.gateway
# Live mode fails closed until production adapters are configured.
# DATABASE_URL=postgresql://gateway:CHANGE_ME@localhost:5432/gateway

# Optional verified public contact / operator details. Leave unset until supplied.
# Contact links open the visitor's email/telephone app; no form or email is sent
# by this installation. These values do not activate any live project integration.
# GATEWAY_OPERATOR_NAME=
# GATEWAY_CONTACT_PERSON=
# GATEWAY_CONTACT_EMAIL=
# GATEWAY_CONTACT_PHONE=
# Separate postal address lines with | (street | postal code and city | country).
# GATEWAY_OPERATOR_ADDRESS=
# GATEWAY_OPERATOR_REPRESENTATIVE=
# GATEWAY_OPERATOR_REGISTER=
# GATEWAY_OPERATOR_VAT_ID=
